manifest {
    mainScript = 'AMRFlow.nf'
    nextflowVersion = '>=23.01.0'
}

// Global default params, used in configs
params {
    // global prameter
    input                       = ""
    threads                     = 32                          //default 32
    output_dir                  = "./results"                 // default ./results
    no_summary                  = false                       // default false
    db_dir                      = ""
    help                        = false
    plots                       = false                       //default false
    IGS                         = false                       //default false

    // update config    
    update                      = false                          
    abricate_update_db          = "ncbi"                      //default ncbi

    // tools 
    run_abricate                = false
    run_amrfinder               = false
    run_deeparg                 = false
    run_fargene                 = false
    run_staramr                 = false

    min_ID                      = 90                          //default 90%
    min_COV                     = 90                          //default 90%


    // ----------------abricate--------------------

    abricate_db                 = "ncbi"                     //default

    // ----------------amrfinder-------------------

    organism_amrfinder          = ""                          //default none



    // -----------------deeparg--------------------



    // -----------------fARGene--------------------

    hmm_model = "class_a"

}


profiles {
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
        useMamba               = true  // Enable Mamba
    }
    mamba {
        conda.enabled          = true
        conda.useMamba         = true
        docker.enabled         = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        conda.enabled          = false
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
        singularity.envWhitelist = "HTTPS_PROXY,HTTP_PROXY,http_proxy,https_proxy,FTP_PROXY"
    }
    slurm {
        executor {
            name = "slurm"
            queueSize = params.setup ? 1 : 100
            // exitReadTimeout = "360 sec"
            // submitRateLimit = '1 / 2 s'
            // pollInterval = '30 sec'
        }
        process.cache = "lenient"
    }
    // test      { includeConfig 'conf/test.config'      }
    // test_full { includeConfig 'conf/test_full.config' }
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'


